PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Leave empty. Register PayPal webhook stores the id. A value here blocks a new registration.
PAYPAL_WEBHOOK_ID=
# The one address allowed to press Register PayPal webhook. Must match the signed-in email.
PAYPAL_ADMIN_EMAIL=
# Public https origin, no path. Example: https://paypilot.example.com
# Required only for Register PayPal webhook. Localhost is rejected.
APP_PUBLIC_URL=
# Required for Grok. Without it the desk still drafts from a local parser.
XAI_API_KEY=
# Leave empty for the built-in local database. Set this only for Neon.
DATABASE_URL=
# Required on any host that is not http://localhost:8080 or *.grok-sandbox.com.
# BETTER_AUTH_URL=https://paypilot.example.com
# BETTER_AUTH_SECRET=
